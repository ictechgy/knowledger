{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["apps/api/**/*.ts", "packages/**/*.ts", "infra/fabric/*.ts", "tools/*.ts"],
  "exclude": ["**/node_modules", "**/dist"]
}
